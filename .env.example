# Anthropic API key for LLM-based actor
ANTHROPIC_API_KEY=

# MCP inter-server authentication
# Key this server presents on outbound requests to opponent
MCP_API_KEY=change-me-server-a

# Comma-separated keys accepted on inbound requests
MCP_ALLOWED_API_KEYS=change-me-server-a,change-me-server-b

# Opponent server base URL (e.g. http://localhost:8002)
OPPONENT_MCP_URL=

# Gmail reporting plugin (off by default)
GMAIL_ENABLED=false
GMAIL_RECIPIENT=
GMAIL_TOKEN_PATH=config/gmail_token.json
GMAIL_CREDENTIALS_PATH=config/gmail_credentials.json
REPORT_TYPE=internal
