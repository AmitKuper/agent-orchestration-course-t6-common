# Anthropic API key for LLM-based actor
ANTHROPIC_API_KEY=

# Ollama local LLM (used when ANTHROPIC_API_KEY is not set)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:4b

# Pluggable actor injection (takes priority over LLM and random)
# ACTOR_CLASS=actor_t6.qtable_actor.QTableActor
# ACTOR_TABLE=models/cop_qtable.npy   (cop server) or models/thief_qtable.npy (thief server)

# MCP inter-server authentication
# Key this server presents on outbound requests to opponent
MCP_API_KEY=change-me-server-a

# Comma-separated keys accepted on inbound requests
MCP_ALLOWED_API_KEYS=change-me-server-a,change-me-server-b

# Opponent server base URL (e.g. http://localhost:8002)
OPPONENT_MCP_URL=

# Gmail reporting plugin (off by default)
GMAIL_ENABLED=false
GMAIL_RECIPIENT=
GMAIL_TOKEN_PATH=config/gmail_token.json
GMAIL_CREDENTIALS_PATH=config/gmail_credentials.json
REPORT_TYPE=internal

# This server's player display name (used in game summary emails)
PLAYER_NAME=
# Opponent's name — only needed when running both servers locally for testing
OPPONENT_PLAYER_NAME=
